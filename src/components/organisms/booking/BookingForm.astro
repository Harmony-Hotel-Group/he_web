---
import Button from "@/components/atoms/button/Button.astro";
import Icono from "@/components/atoms/Icono.astro";
import Label from "@/components/atoms/Label.astro";
import TextAreaInput from "@/components/atoms/TextAreaInput.astro";
import BookingSummaryModal from "@/components/molecules/booking/BookingSummaryModal.astro";
import DatePickerField from "@/components/molecules/forms/DatePickerField.astro";
import DropDownField from "@/components/molecules/forms/DropdownField.astro";
import SwitchField from "@/components/molecules/forms/SwitchField.astro";
import { Translations } from "@/i18n/translation.ts";
import Grid from "@/layouts/GridLayout.astro";
import Row from "@/layouts/Row.astro";
import type { SiteConfig } from "@/types/config";
import { range } from "@/utils/math.ts";
import BookingFormBreakfast from "./BookingFormBreakfast.astro";

// Sub-componentes locales
import BookingFormDates from "./BookingFormDates.astro";
import BookingFormGuestCount from "./BookingFormGuestCount.astro";
import BookingFormSpecialRequests from "./BookingFormSpecialRequests.astro";
import BookingFormSubmit from "./BookingFormSubmit.astro";
import BookingFormVehicleFields from "./BookingFormVehicleFields.astro";
import BookingFormVehicleToggle from "./BookingFormVehicleToggle.astro";
import BookingVehicleSection from "./BookingVehicleSection.astro";

interface Props {
	lang: string;
	config: SiteConfig;
}

const { lang, config } = Astro.props;
const t = Translations(lang);

// ── Opciones ─────────────────────────────────────────────────────
const adultsOptions = range(1, 9).map((i, idx, arr) => ({
	value: idx === arr.length - 1 ? "group" : String(i),
	label:
		idx === arr.length - 1
			? t("booking.dropdown.optGroup")
			: `${i} ${i > 1 ? t("booking.dropdown.plural") : ""}`,
}));
const childrenOptions = range(0, 8).map((i) => ({
	value: String(i),
	label: `${t("booking.dropdown.optChildren")} ${i}`,
}));
const roomsOptions = [1, 2, 3, 4].map((i) => ({
	value: String(i),
	label: `${t("booking.dropdown.optRooms")} ${i}`,
}));
const whatsappNumber = config?.contactInfo?.whatsapp ?? "";
const email = config?.contactInfo?.email ?? "";

// ── Estado inicial (server renderizado) ──────────────────────────
const initialAdults = 2;
const initialChildren = 0;
const initialRooms = 1;
const initialBreakfast = false;
const initialDistribution = false;

// ── Helpers ─────────────────────────────────────────────────────
const formatCurrency = (amount: number, currency: string) =>
	new Intl.NumberFormat(lang, { style: "currency", currency }).format(amount);

function buildGroupMessage(data: Record<string, unknown>): string {
	return `Grupo: ${JSON.stringify(data)}`;
}

function buildStandardMessage(data: Record<string, unknown>): string {
	return `Reserva: ${JSON.stringify(data)}`;
}
---

<!-- ═══════════════════════════════════════════════════ -->
<!-- BookingForm — Fraccionado (BookingFormDates, etc.) -->
<!-- ═══════════════════════════════════════════════════ -->
<form id="booking-form" class="space-y-4" novalidate>
	<!-- Standard: dates + guest counts -->
	<BookingFormDates {lang} {config} />

	<!-- Distribution toggle (Adultos individuales → Grupo) -->
	<div id="switch-adults-group" class="flex flex-wrap gap-2 items-center">
		<label class="inline-flex items-center cursor-pointer">
			<input type="checkbox" name="adultsDistributed" id="adultsDistributed" class="sr-only peer" />
			<span class="text-sm">{t("booking.distribution.label")}</span>
		</label>
	</div>

	<!-- Guest counts (solo se muestra en modo grupo) -->
	<BookingFormGuestCount
		lang={lang}
		adults={initialAdults}
		children={initialChildren}
		teens={0}
		groupLabel={t("booking.dropdown.optGroup")}
	/>

	<!-- Switches -->
	<div class="space-y-3 pt-2">
		<BookingFormBreakfast lang={lang} withBreakfast={initialBreakfast} />

		<BookingFormVehicleToggle lang={lang} hasVehicles={config?.vehicleTypeOptions?.length > 0} />

		{config?.vehicleTypeOptions?.length > 0 && (
			<BookingFormVehicleFields config={config} lang={lang} />
		)}
	</div>

	<!-- Resumen rápido -->
	<BookingSummaryModal {lang} />

	<!-- Acciones -->
	<BookingFormSubmit lang={lang} pending={false} />
</form>

<!-- Estilos locales -->
<style>
	#booking-form input,
	#booking-form select,
	#booking-form textarea {
		border: 1px solid var(--color-gray-300, #d1d5db);
		border-radius: 0.375rem;
		background-color: white;
	}
	#booking-form input:focus,
	#booking-form select:focus,
	#booking-form textarea:focus {
		outline: none;
		border-color: transparent;
		box-shadow: 0 0 0 2px var(--color-accent, #bf953d);
	}
	.dark #booking-form input,
	.dark #booking-form select,
	.dark #booking-form textarea {
		border-color: var(--color-gray-600, #4b5563);
	}
	.dark #booking-form input:focus,
	.dark #booking-form select:focus,
	.dark #booking-form textarea:focus {
		box-shadow: 0 0 0 2px var(--color-accent, #bf953d);
	}
</style>
