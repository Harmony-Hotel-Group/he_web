---
// src/layouts/BaseLayout.astro
// Layout principal usando el componente SEO centralizado

import { ClientRouter } from "astro:transitions";
import WhatsAppButton from "@/components/atoms/WhatsAppButton.astro";
import Footer from "@/components/core/Footer.astro";
import Header from "@/components/core/Header.astro";
import ToastContainer from "@/components/organisms/notifications/ToastContainer.astro";
import SizeIndicator from "@/dev/SizeIndicator.astro";
import SeoHead from "@/components/core/seo/SeoHead.astro";
import { getCurrentLang, Translations } from "@/i18n/translation";
import type { SiteConfig } from "@/types/config-site";
import "@glidejs/glide/dist/css/glide.core.min.css";
import "@glidejs/glide/dist/css/glide.theme.min.css";
import "@/styles/global.css";

const {
	titleKey,
	lang,
	config,
	description,
	ogImage,
	articleDate,
	headerBgClass,
	py = "",
} = Astro.props;

// Solo detectar idioma por URL pathname
const currentLang = getCurrentLang(Astro.url);
const t = Translations(lang);

// Construir URLs canónicas de forma segura (mantenemos esta lógica por si el componente SeoHead la necesita)
let cleanPath = "/";
let baseUrl = import.meta.env.VERCEL_URL
	? `https://${import.meta.env.VERCEL_URL}`
	: "https://hotelensuenos.com";

try {
	if (Astro.url?.pathname) {
		cleanPath = Astro.url.pathname.replace(/^\/en/, "") || "/";
	}
	if (Astro.site) {
		baseUrl = Astro.site.toString().replace(/\/$/, "");
	}
} catch (error) {
	// Error al construir URLs — usar defaults
}
---

<html lang={currentLang}>
    <head>
        <SeoHead
            title={t(titleKey)}
            description={description || t("meta.description")}
            lang={currentLang}
            config={config as SiteConfig}
            canonicalPath={cleanPath}
            ogImage={ogImage}
            type={articleDate ? "article" : "website"}
            publishedTime={articleDate}
            // Para el layout principal, dejamos que el componente genere el esquema Hotel por defecto
            // En páginas específicas, se puede sobrescribir con structuredData o tipo
        />
        <!-- View Transitions -->
        <ClientRouter />
        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
            rel="stylesheet"
        />

        <!-- Mixpanel Analytics -->
