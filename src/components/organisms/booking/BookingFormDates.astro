---
// src/components/organisms/booking/BookingFormDates.astro
import DatePickerField from "@/components/molecules/forms/DatePickerField.astro";
import DropDownField from "@/components/molecules/forms/DropdownField.astro";
import { Translations } from "@/i18n/translation.ts";
import Grid from "@/layouts/GridLayout.astro";
import { useBookingOptions } from "@/composables/useBookingOptions";
import type { SiteConfig } from "@/types/config-site";

interface Props {
	lang: string;
	config?: SiteConfig;
}

const { lang, config } = Astro.props;
const t = Translations(lang);

// Usar el composable centralizado para generar opciones
const { adultsOptions, childrenOptions, roomsOptions } = useBookingOptions(t);
---
<!-- Standard Fields: dates + guest counts -->
<div id="standard-fields" class="space-y-4">
	<!-- Date Range -->
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
		<DatePickerField
			name="checkin"
			lblKey="booking.checkin"
			lang={lang}
			icon="form/calendar"
			syncGroup="booking"
		/>
		<DatePickerField
			name="checkout"
			lblKey="booking.checkout"
			lang={lang}
			icon="form/calendar-out"
			syncGroup="booking"
		/>
	</div>

	<!-- Guest counts: Adults, Children, Rooms -->
	<Grid cols={3} gap="gap-3">
		<DropDownField
			id="adults"
			name="adults"
			fieldId="adults"
			lblKey="booking.dropdown.adults"
			lang={lang}
			icon="form/users"
			options={adultsOptions}
			required
		/>
		<DropDownField
			id="children"
			name="children"
			fieldId="children"
			lblKey="booking.dropdown.children"
			lang={lang}
			icon="form/child"
			options={childrenOptions}
		/>
		<DropDownField
			id="rooms"
			name="rooms"
			fieldId="rooms"
			lblKey="booking.dropdown.rooms"
			lang={lang}
			icon="form/home"
			options={roomsOptions}
			required
		/>
	</Grid>
</div>
