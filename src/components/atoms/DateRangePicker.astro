---
// src/components/atoms/DateRangePicker.astro
/**
 * DateRangePicker con sincronización automática
 * Se sincroniza con otros DatePickers del mismo syncGroup
 */

interface Props {
	id: string;
	lang?: string;
	name?: string;
	placeholder?: string;
	lblKey?: string; // Clave de traducción para el label
	syncGroup?: string; // Grupo de sincronización (default: 'booking')
}

const {
	id,
	name,
	lang,
	placeholder,
	lblKey,
	syncGroup = "booking", // Por defecto todos los date pickers de booking se sincronizan
} = Astro.props;
---

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"
/>

<div class="relative w-full">
    {lblKey && <label for={id} class="sr-only">{placeholder || lblKey}</label>}
    <input
        id={id}
        name={name}
        type="text"
        data-lang={lang}
        data-sync-group={syncGroup}
        placeholder={placeholder}
        readonly
        class="w-full p-2 border rounded-md cursor-pointer date-range-picker-input"
    />
</div>

<style>
    .date-range-picker-input {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        background: white;
        cursor: pointer;
    }

    .date-range-picker-input:focus {
        outline: none;
        ring: 2px;
        ring-color: rgb(59 130 246);
        border-color: rgb(59 130 246);
    }

    /* Asegurar que el calendario siempre quede por encima de overlays (hero, modales) */
    .flatpickr-calendar {
        z-index: 10000 !important;
    }
</style>

<script>
    import { bootstrapDatePicker } from "@/composables/useDatePicker";
    import { logger } from "@/services/logger.ts";

    const log = logger("DateRangePicker");

    // Inicializar todos los date pickers cuando el componente esté listo
    bootstrapDatePicker();
</script>
